# Week 12 - Starter
# Copy this file to .env and fill in your Supabase project values.
# .env is gitignored — never commit real keys to source control.
#
# Find these values in: Supabase Dashboard → Project Settings → API
#   - Project URL       → EXPO_PUBLIC_SUPABASE_URL
#   - Publishable key   → EXPO_PUBLIC_SUPABASE_ANON_KEY

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key-here
