{
  "expo": {
    "name": "Campus Hub",
    "slug": "campus-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fullnavigation",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": { // add permission descriptions for iOS
        "NSCameraUsageDescription": "Campus Hub uses your camera so you can take a profile photo.", // allow camera access for profile photo
        "NSPhotoLibraryUsageDescription": "Campus Hub accesses your photo library so you can choose a profile photo.", // allow access to photo library for profile photo
        "NSLocationWhenInUseUsageDescription": "Campus Hub uses your location to show where you are on the campus map." // allow access to location for campus map
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA", // allow camera access for profile photo
        "android.permission.READ_EXTERNAL_STORAGE", // allow access to external storage
        "android.permission.READ_MEDIA_IMAGES", // allow access to media images
        "android.permission.ACCESS_FINE_LOCATION", // allow access to fine location
        "android.permission.ACCESS_COARSE_LOCATION" // allow access to coarse location
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Campus Hub accesses your photo library so you can choose a profile photo.", // allow access to photo library for profile photo
          "cameraPermission": "Campus Hub uses your camera so you can take a profile photo.", // allow camera access for profile photo
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Campus Hub uses your location to show where you are on the campus map." // allow access to location for campus map
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
